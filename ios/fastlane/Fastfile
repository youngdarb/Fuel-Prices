default_platform(:ios)

MATCH_GIT_URL = "https://github.com/youngdarb/ios-certificates.git"
BUNDLE_ID = "com.gsyfuelprices.ios"

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV["APPSTORE_KEY_ID"],
    issuer_id: ENV["APPSTORE_ISSUER_ID"],
    key_content: ENV["APPSTORE_PRIVATE_KEY"]
  )
end

platform :ios do
  desc "One-off: revoke existing distribution certs (frees Apple's cert quota)"
  lane :nuke do
    asc_api_key
    match_nuke(
      type: "appstore",
      git_url: MATCH_GIT_URL,
      git_basic_authorization: ENV["MATCH_GIT_BASIC_AUTHORIZATION"],
      skip_confirmation: true
    )
  end

  desc "Build signed IPA and upload to TestFlight/App Store Connect"
  lane :release do
    api_key = asc_api_key

    create_keychain(
      name: "ci",
      password: "ci_password",
      default_keychain: true,
      unlock: true,
      timeout: 3600
    )

    # Certificates + profile from the encrypted private repo,
    # created there once and reused on every run
    match(
      type: "appstore",
      app_identifier: BUNDLE_ID,
      git_url: MATCH_GIT_URL,
      git_basic_authorization: ENV["MATCH_GIT_BASIC_AUTHORIZATION"],
      keychain_name: "ci",
      keychain_password: "ci_password",
      readonly: false
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "pwa-shell.xcodeproj",
      team_id: ENV["APPLE_TEAM_ID"],
      code_sign_identity: "Apple Distribution",
      profile_name: lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING][BUNDLE_ID],
      targets: ["pwa-shell"]
    )

    build_app(
      workspace: "pwa-shell.xcworkspace",
      scheme: "pwa-shell",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "GSYFuel.ipa"
    )

    # NOTE: the App Store Connect app record cannot be created via API —
    # it must exist already (My Apps → + → New App, bundle id com.gsyfuelprices.ios)
    upload_to_testflight(
      api_key: api_key,
      ipa: "build/GSYFuel.ipa",
      skip_waiting_for_build_processing: true
    )
  end
end

platform :ios do
  desc "Read-only: report App Store Connect state (versions, builds, review status)"
  lane :status do
    api_key = asc_api_key
    Spaceship::ConnectAPI.auth(
      key_id: api_key[:key_id],
      issuer_id: api_key[:issuer_id],
      key: api_key[:key]
    )

    app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
    if app.nil?
      UI.user_error!("No app found for #{BUNDLE_ID}")
    end
    UI.important("APP: #{app.name} | #{app.bundle_id} | id=#{app.id}")

    begin
      app.get_app_store_versions.first(5).each do |v|
        UI.important("VERSION #{v.version_string} state=#{v.app_store_state} platform=#{v.platform}")
      end
    rescue => e
      UI.error("versions: #{e.message}")
    end

    begin
      builds = app.get_builds(sort: "-uploadedDate")
      if builds.empty?
        UI.important("BUILDS: none")
      else
        builds.first(5).each do |b|
          UI.important("BUILD #{b.app_version} (#{b.version}) processing=#{b.processing_state} expired=#{b.expired}")
        end
      end
    rescue => e
      UI.error("builds: #{e.message}")
    end
  end
end

platform :ios do
  desc "Upload App Store listing metadata and screenshots. Does not submit."
  lane :listing do
    api_key = asc_api_key
    upload_to_app_store(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      skip_binary_upload: true,
      overwrite_screenshots: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      force: true
    )
  end
end
